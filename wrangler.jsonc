{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mile-bonus-hub",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "build": {
    "command": "npm run build"
  },
  "observability": {
    "enabled": true
  }
}
